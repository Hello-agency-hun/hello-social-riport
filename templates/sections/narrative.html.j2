{% if narrative and narrative.executive_summary %}
<section class="page">
  <div class="eyebrow">{{ t.executive_summary }}</div>
  <h2 style="margin-bottom:36px">{{ t.month_in_brief }}</h2>
  <div class="fill">
  <p style="font-size:26px;line-height:1.5;max-width:1000px;color:var(--ink)"
     data-narrative="executive_summary">
    {{ narrative.executive_summary | safe }}
  </p>
  </div>
</section>
{% endif %}

{% if narrative and narrative.key_finding %}
<section class="page" style="justify-content:center">
  <div class="eyebrow">{{ t.key_finding }}</div>
  <h2 data-narrative="key_finding.title" style="font-size:60px;margin:18px 0 28px;max-width:1100px">
    {{ narrative.key_finding.title | safe }}
  </h2>
  <p data-narrative="key_finding.body" style="font-size:22px;line-height:1.5;max-width:900px">
    {{ narrative.key_finding.body | safe }}
  </p>
</section>
{% endif %}

{% if narrative and (narrative.what_worked or narrative.what_to_improve) %}
<section class="page">
  <div class="eyebrow">{{ t.assessment }}</div>
  <h2 style="margin-bottom:36px">{{ t.what_worked_title }}</h2>
  <div class="grid" style="grid-template-columns:1fr 1fr">
    <div class="panel">
      <h3 class="accent" style="margin-bottom:16px">{{ t.what_worked }}</h3>
      <ul style="padding-left:20px">
        {% for item in narrative.what_worked %}
        <li style="margin-bottom:{{ 14 if assessment_font >= 18 else 10 }}px;font-size:{{ assessment_font }}px"
            data-narrative="what_worked.{{ loop.index0 }}">{{ item | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="panel">
      <h3 style="margin-bottom:16px">{{ t.what_to_improve }}</h3>
      <ul style="padding-left:20px">
        {% for item in narrative.what_to_improve %}
        <li style="margin-bottom:{{ 14 if assessment_font >= 18 else 10 }}px;font-size:{{ assessment_font }}px"
            data-narrative="what_to_improve.{{ loop.index0 }}">{{ item | safe }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

{% if narrative and narrative.next_steps %}
<section class="page">
  <div class="eyebrow">{{ t.next_steps }}</div>
  <h2 style="margin-bottom:36px">{{ t.next_month }}</h2>
  <div class="fill">
  <ol style="padding-left:26px;font-size:20px">
    {% for item in narrative.next_steps %}
    <li style="margin-bottom:22px;color:var(--ink);font-size:21px"
        data-narrative="next_steps.{{ loop.index0 }}">{{ item | safe }}</li>
    {% endfor %}
  </ol>
  </div>
</section>
{% endif %}
