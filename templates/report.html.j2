{% from "macros.html.j2" import slot, delta %}
<!doctype html>
<html lang="{{ data.meta.language }}">
<head>
<meta charset="utf-8">
<title>{{ data.meta.client }} — {{ period_name }}</title>
{# A stíluslap a saját tartalmunk, nem felhasználói adat. Escape-elve az
   idézőjelek `&#34;`-re válnának, amitől a `@font-face src` és a `--font`
   érvénytelen lenne — a riport néma talpas fallback fontra váltana. #}
<style>{{ css | safe }}</style>
</head>
<body>

<button class="pdf-button no-print" onclick="window.print()">{{ t.download_pdf }}</button>

<section class="page" style="justify-content:flex-end">
  <div style="width:300px;color:var(--ink);margin-bottom:auto">{{ logo_lockup | safe }}</div>
  <div class="eyebrow">{{ t.cover_eyebrow }}</div>
  <h1>{{ data.meta.client }}</h1>
  <h2 style="color:var(--ink-soft);font-weight:500;margin-top:14px">{{ period_name }}</h2>
  {# A pontos időszak nem formaság. A korábbi, kézzel készült riportok
     metrikánként hét-tíz nappal korábban zárultak — a készítő más napokon
     nyitotta meg az egyes csempéket. Az ügyfél ezért ugrást fog látni az
     átálláskor, és annak megmagyarázhatónak kell lennie. Ha a riport nem
     mondja ki, mit mért, a magyarázat nem áll meg. #}
  <p class="note" style="margin-top:10px">
    {{ t.measured_period }}: {{ period_range }}
    {%- if coverage_partial %} · <strong>{{ t.month_not_closed }}</strong>,
    {{ t.data_until_here }}{% endif %}
  </p>
  {% if period_warning %}
  <div class="period-warning" style="margin-top:14px">{{ period_warning }}</div>
  {% endif %}
</section>

<section class="page">
  <div class="eyebrow">{{ t.overview }}</div>
  <h2 style="margin-bottom:44px">{{ t.month_in_numbers }}</h2>
  <div class="grid" style="grid-template-columns:repeat(4,1fr)">
    <div>
      <div class="stat">{{ data.content.total }}</div>
      <div class="stat-label">{{ t.content_published }}</div>
    </div>
    <div>
      <div class="stat">{{ data.cross.post_reach_sum | num }}</div>
      <div class="stat-label">{{ t.post_reach_total }}</div>
    </div>
    <div>
      <div class="stat stat--sm">{{ data.paid.spend | money(currency) }}</div>
      <div class="stat-label">{{ t.ad_spend }}</div>
    </div>
    <div>
      <div class="stat accent">{{ data.cross.reach_multiplier | num(1) }}×</div>
      <div class="stat-label">{{ t.boosted_vs_organic }}</div>
    </div>
  </div>
  <p class="note" style="margin-top:auto">
    {{ t.post_reach_note }}
  </p>
</section>

<section class="page">
  <div class="eyebrow">{{ t.what_we_did }}</div>
  <h2 style="margin-bottom:40px">{{ t.month_content }}</h2>
  <div class="grid" style="grid-template-columns:repeat({{ data.content.by_type | length }},1fr)">
    {% for kind, count in data.content.by_type.items() %}
    <div class="panel">
      <div class="stat">{{ count }}</div>
      <div class="stat-label">{{ kind | ptype }}</div>
    </div>
    {% endfor %}
  </div>
  {% if data.content.stories_by_channel %}
  <p style="margin-top:32px">
    {{ t.stories_by_channel }}
    {% for channel, count in data.content.stories_by_channel.items() %}
    <strong>{{ channel | channel }} {{ count }}</strong>{{ "" if loop.last else " · " }}
    {% endfor %}
  </p>
  {% endif %}
</section>

{% include "sections/trends.html.j2" %}

{% include "sections/comparison.html.j2" %}

{% include "sections/channel.html.j2" %}

<section class="page">
  <div class="eyebrow">{{ t.paid_advertising }}</div>
  <h2 style="margin-bottom:36px">{{ t.campaigns_by_result }}</h2>
  {% if ads_period.accuracy == "indicative" %}
  <div class="period-warning" style="margin-bottom:22px">
    <strong>{{ t.ads_indicative_label }}</strong> · {{ t.ads_indicative_body }}
    {{ t.campaign_report_window }}: {{ ads_period.report_start }} – {{ ads_period.report_end }}.
  </div>
  {% endif %}
  <table>
    <tr><th>{{ t.result_type }}</th><th class="num">{{ t.campaign }}</th>
        <th class="num">{{ t.spend | capitalize }}</th><th class="num">{{ t.result }}</th></tr>
    {% for kind, block in data.paid.by_result_type.items() %}
    <tr>
      <td>{{ kind | result }}</td>
      <td class="num">{{ block.campaigns }}</td>
      <td class="num">{{ block.spend | money(currency) }}</td>
      <td class="num">{{ block.results | num }}</td>
    </tr>
    {% endfor %}
  </table>
  {# Valódi költés, ami eddig teljesen kimaradt a riportból: a poszt egy
     korábbi hónapban jelent meg, a hirdetés viszont ebben a hónapban futott
     rá. Poszt-kártya nem tartozik hozzá — de a pénz elment, és az ügyfél
     látja a számlán. #}
  {% if data.quality.earlier_posts_boosted_now %}
  <p class="note" style="margin-top:20px">
    {{ t.earlier_posts_note_1 }} <strong>{{ data.quality.earlier_posts_boosted_now | length }}</strong>
    {{ t.earlier_posts_note_2 }}
    ({{ data.quality.earlier_posts_boosted_now | sum(attribute="spend") | money(currency) }}).
    {{ t.earlier_posts_note_3 }}
  </p>
  {% endif %}
  <p class="note" style="margin-top:auto">
    {{ t.result_types_note }}
  </p>
</section>

{% for campaigns in campaign_pages %}
<section class="page campaign-status-page" data-campaign-page="{{ loop.index }}">
  <div class="eyebrow">{{ t.campaign_status_eyebrow }}</div>
  {% if loop.first and campaign_narrative.title %}
  <h2 data-narrative="campaign_status.title" style="margin:10px 0 12px">{{ campaign_narrative.title | safe }}</h2>
  {% else %}
  <h2 style="margin:10px 0 12px">{{ t.campaign_status_title }}</h2>
  {% endif %}
  {% if loop.first and campaign_narrative.body %}
  <p data-narrative="campaign_status.body" class="campaign-status-copy">{{ campaign_narrative.body | safe }}</p>
  {% elif loop.first %}
  <p class="campaign-status-copy">{{ t.campaign_status_body }}</p>
  {% endif %}

  {% if loop.first and campaign_status_counts %}
  <div class="status-counts">
    {% for status, count in campaign_status_counts %}
    <span class="status-count" data-status-count><strong>{{ count }}</strong> {{ status }}</span>
    {% endfor %}
  </div>
  {% endif %}

  <div class="campaign-list">
  {% for campaign in campaigns %}
    <div class="campaign-row" data-campaign-value>
      <div class="campaign-name">
        <strong>{{ campaign.name }}</strong>
        {% if campaign.start_date %}
        <div class="campaign-duration">{{ campaign.start_date }} → {{ campaign.display_end }}</div>
        {% endif %}
      </div>
      <div><span class="status-pill">{{ campaign.display_status }}</span></div>
      <div><span class="campaign-label">{{ t.campaign_end }}</span>{{ campaign.display_end }}</div>
      <div class="num"><span class="campaign-label">{{ t.campaign_result }}</span>{{ campaign.results | num }} · {{ campaign.result_type | result }}</div>
    </div>
  {% endfor %}
  </div>

  <p class="note campaign-window-note">
    {% if ads_period.accuracy == "indicative" %}<strong>{{ t.ads_indicative_label }}</strong> · {% else %}<strong>{{ t.ads_exact_label }}</strong> · {% endif %}
    {{ t.campaign_report_window }}: {{ ads_period.report_start }} – {{ ads_period.report_end }}.
    {% if ads_period.accuracy == "indicative" %}{{ t.ads_indicative_body }}{% endif %}
  </p>
</section>
{% endfor %}

<section class="page">
  <div class="eyebrow">{{ t.organic_and_paid }}</div>
  <h2 style="margin-bottom:24px">{{ t.what_boost_is_worth }}</h2>
  <div class="grid" style="grid-template-columns:1fr 1fr;align-items:center">
    <div style="max-width:400px">{{ charts.reach_split | safe }}</div>
    <div>
      <div class="stat">{{ data.cross.avg_reach_organic_post | num }}</div>
      <div class="stat-label">{{ t.avg_organic_reach }}</div>
      <div class="stat accent" style="margin-top:34px">{{ data.cross.avg_reach_boosted_post | num }}</div>
      <div class="stat-label">{{ t.avg_boosted_reach }}</div>
      <p style="margin-top:28px">
        {{ data.cross.posts_boosted }} {{ t.boosted_posts }},
        {{ data.cross.boost_spend | money(currency) }} {{ t.with_spend }}
        <strong>{{ (data.cross.boosted_share_of_post_reach * 100) | num(1) }}%</strong>{{ t.share_of }}
      </p>
    </div>
  </div>
</section>

{% include "sections/narrative.html.j2" %}

<section class="page">
  <div class="eyebrow">{{ t.summary }}</div>
  {# Nem „KPI”: nem minden ügyfélnél van kimondott vállalás, és egy
     számtáblát célként feltüntetni olyat ígér, amit nem vállaltunk. #}
  <h2 style="margin-bottom:40px">{{ t.month_focus }}</h2>
  <div class="grid" style="grid-template-columns:repeat(3,1fr)">
    <div>
      <div class="stat">{{ data.content.total }}</div>
      <div class="stat-label">{{ t.content_published }}</div>
    </div>
    <div>
      <div class="stat">{{ data.cross.post_reach_sum | num }}</div>
      <div class="stat-label">{{ t.post_reach }}</div>
    </div>
    <div>
      <div class="stat stat--sm">{{ data.paid.spend | money(currency) }}</div>
      <div class="stat-label">{{ t.ad_spend }}</div>
    </div>
    <div>
      <div class="stat accent">{{ data.cross.avg_reach_boosted_post | num }}</div>
      <div class="stat-label">{{ t.avg_boosted_reach }}</div>
    </div>
    <div>
      <div class="stat">{{ data.cross.avg_reach_organic_post | num }}</div>
      <div class="stat-label">{{ t.avg_organic_reach }}</div>
    </div>
    <div>
      <div class="stat accent">{{ data.cross.reach_multiplier | num(1) }}×</div>
      <div class="stat-label">{{ t.boost_multiplier }}</div>
    </div>
  </div>
  {# Itt korábban négy üres, szaggatott doboz állt olyan adatokra, amiket a Meta
     nem exportál. Az ügyfél ebből azt olvasta ki, hogy elfelejtettünk valamit.
     Most az áll itt, amit MÉRÜNK — pontos névvel, hogy ne lehessen összekeverni
     a havi eléréssel. Amit nem mérünk, arról a `--validate` szól, a
     menedzsernek. #}
  <div class="grid" style="grid-template-columns:repeat(4,1fr);margin-top:36px">
    {% for name, block in data.get("audience", {}).items() %}
    {% if block.followers %}
    <div>
      <div class="stat stat--sm">{{ block.followers | num }}</div>
      {# A felirat egy sor, a másodlagos infó alatta. Egy sorba fűzve a
         hosszabbak kettétörnek, és a csempék nem állnak egy vonalban. #}
      <div class="stat-label">{{ name | channel }} {{ t.follower }}</div>
      {% if block.new_followers %}
      <p class="note" style="margin-top:6px">
        {{ delta(block.new_followers) }} {{ block.new_followers | signed }} a hónapban
      </p>
      {% endif %}
    </div>
    {% endif %}
    {# Ha a menedzser megadta a havi elérést, az a legerősebb szám a lapon:
       ez az egyetlen deduplikált érték, amit a Meta ad. #}
    {% if block.monthly_reach %}
    <div>
      <div class="stat stat--sm">{{ block.monthly_reach | num }}</div>
      <div class="stat-label">{{ name | channel }} {{ t.monthly_reach }}</div>
      {% if block.reach_per_follower %}
      <p class="note" style="margin-top:6px">
        {{ block.reach_per_follower | num(1) }}{{ t.times_the_audience }}
      </p>
      {% endif %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  <p class="note" style="margin-top:auto">
    {{ t.measured_period }}: <strong>{{ period_range }}</strong> {{ t.footer_note }}
    {{ t.generated_on }} {{ generated }}.
  </p>
</section>

<section class="page" style="justify-content:flex-end">
  <div style="width:150px;color:var(--ink);margin-bottom:auto">{{ logo_mark | safe }}</div>
  <h2>{{ t.lets_talk }}</h2>
  {# Ügyfelenként külön postafiók van. A cím a `client.yaml`-ből jön; ha ott
     nincs megadva, a mappanévből tippelünk, és a `--validate` szól érte. #}
  <p style="margin-top:22px">+36 1 365 1788 · {{ data.meta.contact_email }} · helloagency.hu</p>
  <p style="margin-top:26px;font-size:22px;color:var(--ink-soft)">{{ t.thanks }}</p>
  <div class="eyebrow" style="margin-top:36px">HELLO Agency</div>
</section>

{# A gombfeliratok a riport nyelvén — a JavaScript a sablonon kívül él, és
   az angol próbán pont ezek maradtak magyarul egy egyébként angol riporton. #}
<script>window.__helloLabels = {{ ui_labels | safe }};</script>
<script>{{ review_js | safe }}</script>
</body>
</html>
